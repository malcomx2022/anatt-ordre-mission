# Dépendances
node_modules/
vendor/
# Archive de déploiement (régénérable) — cf. UPLOAD-VENDOR.md
vendor.zip
*.zip

# Environnement
.env
.env.local
*.env.backup

# Dumps & sauvegardes de base de données (données sensibles : ne JAMAIS versionner)
*.sql
*.sql.gz
backend/storage/app/backups/

# Builds
# frontend/dist/ n'est PAS versionné : il se régénère (`npm run build`) ou se récupère
# depuis l'artefact CI `frontend-dist` du run `main` — cf. DEPLOY-CPANEL.md §2.
frontend/dist/
backend/public/storage

# Logs
*.log
backend/storage/logs/*
frontend/storage/logs/*

# OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.env.*
# Les gabarits de variables (sans secrets) restent versionnés : CI et start-dev.ps1
# copient .env.example ; .env.production.example est le modèle du .env serveur
# (cf. DEPLOY-CPANEL.md §5.1) — il ne contient aucune valeur réelle.
!.env.example
!.env.production.example
*.env
credentials.json
*.pem
*.key
.credentials

# Outillage plateforme / dev — résidus non liés à l'application
.emergent/
.gitconfig
