APP_NAME="ANaTT Gestion Missions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Porto-Novo
# Racine de la SPA Vue : sert à construire les liens des e-mails (réinitialisation
# de mot de passe). À défaut, retombe sur APP_URL.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anatt_missions
DB_USERNAME=root
DB_PASSWORD=
# Binaire mysqldump (absent du PATH sous WAMP) — utilisé par db:backup
# DB_DUMP_BINARY=C:\wamp64\bin\mysql\mysql9.1.0\bin\mysqldump.exe
# Client mysql utilisé par db:restore (restauration d'une sauvegarde)
# DB_RESTORE_BINARY=C:\wamp64\bin\mysql\mysql9.1.0\bin\mysql.exe

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Circuit de validation ──
# false = circuit simple (contrôleur valide en une étape) ; true = circuit
# complet CONTROLEUR → DAF → DG. Bascule = décision d'exploitation explicite.
WORKFLOW_SEPARATION_TACHES=true

# ── Fichiers de paiement Mobile Money ──
# Indicatif pays préfixé au téléphone national, seuil de bascule en file,
# compte émetteur MTN figurant dans l'en-tête du fichier .txt.
PAIEMENT_INDICATIF=229
PAIEMENT_ASYNC_SEUIL=50
MTN_COMPTE=SARALY

# ── Comptes installés par les seeders ──
# Super admin initial (OBLIGATOIRE en production : le seeder lève une erreur sinon).
SUPERADMIN_NAME="Super Administrateur"
SUPERADMIN_EMAIL=superadmin@anatt.bj
# SUPERADMIN_PASSWORD=

# Comptes nominatifs du circuit (ComptesCircuitSeeder, production) : un poste
# non renseigné n'est pas créé ; le mot de passe temporaire est affiché une fois.
# CONTROLEUR_NAME= CONTROLEUR_EMAIL= CONTROLEUR_FONCTION=
# DAF_NAME= DAF_EMAIL= DAF_FONCTION=
# DG_NAME= DG_EMAIL= DG_FONCTION=
