# ─────────────────────────────────────────────────────────────────────────────
# GABARIT DU .env SERVEUR (cPanel mutualisé) — ANaTT Ordres de mission
#
# Copier ce fichier en `anatt-api/.env` sur le serveur, puis remplir les valeurs
# marquées « ← À RENSEIGNER ». Aucune valeur réelle ne doit être commitée ici.
# Référence pas-à-pas : DEPLOY-CPANEL.md §5.1.
#
# Contraintes du mutualisé déjà prises en compte : ni Redis, ni worker de file,
# ni Composer, ni Node sur le serveur → cache/session sur FICHIER, file en SYNC.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="ANaTT Gestion Missions"
APP_ENV=production
# ← À RENSEIGNER : `php artisan key:generate --show` en local, coller le base64:...
APP_KEY=
# JAMAIS true en production : exposerait la configuration et les traces SQL.
APP_DEBUG=false
APP_URL=https://api-omsemo.anatt.bj
# Heure du Bénin. Les horodatages antérieurs (UTC) sont repris par migration.
APP_TIMEZONE=Africa/Porto-Novo
# Racine de la SPA : construit les liens des e-mails (réinitialisation de mot de passe).
FRONTEND_URL=https://omsemo.anatt.bj

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` graverait les payloads en clair dans storage/logs : rester en `error`.
LOG_LEVEL=error

# ── Base de données (cPanel > MySQL® Databases, préfixe du compte : anatt_) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anatt_missions
DB_USERNAME=anatt_oms
# ← À RENSEIGNER : mot de passe de l'utilisateur MySQL créé dans cPanel.
DB_PASSWORD=
# Chemin du binaire mysqldump chez l'hébergeur (utilisé par `artisan db:backup`
# et par l'écran Sauvegardes). À demander au support si `mysqldump` nu échoue ;
# sur beaucoup de cPanel : /usr/bin/mysqldump
DB_DUMP_BINARY=mysqldump
# Client mysql utilisé par la RESTAURATION d'une sauvegarde (`artisan db:restore`
# et écran Sauvegardes). Sur beaucoup de cPanel : /usr/bin/mysql
DB_RESTORE_BINARY=mysql

# ── Origines autorisées du SPA (CORS) ──
# Sans cette ligne, le navigateur bloque tous les appels du SPA. Pas de slash final.
CORS_ALLOWED_ORIGINS=https://omsemo.anatt.bj

# ── Sessions / cache / file : tout sur fichier, aucun service externe ──
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.anatt.bj

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync` = les jobs (génération de lot, export) s'exécutent dans la requête :
# aucun `queue:work` à maintenir sur le mutualisé.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── SMTP de l'hébergeur ← À RENSEIGNER ──
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.anatt.bj
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@anatt.bj"
MAIL_FROM_NAME="${APP_NAME}"

# Auth par token Bearer (pas de cookie cross-domaine) : liste laissée vide.
SANCTUM_STATEFUL_DOMAINS=

# ── Circuit de validation ──
# false = circuit simple (contrôleur valide en une étape) ; true = circuit
# complet CONTROLEUR → DAF → DG. Bascule = décision d'exploitation explicite.
WORKFLOW_SEPARATION_TACHES=true

# ── Fichiers de paiement Mobile Money ──
PAIEMENT_INDICATIF=229
# Au-delà de ce nombre de lignes, la génération partirait en file ; en `sync`
# elle reste synchrone — garder un seuil haut pour éviter un timeout PHP.
PAIEMENT_ASYNC_SEUIL=50
# ← À VÉRIFIER : compte émetteur figurant dans l'en-tête HDR du fichier MTN.
MTN_COMPTE=SARALY

# ── Super admin initial (seeders) ──
# Obligatoire si vous jouez les seeders en production : le seeder échoue sinon.
# Ne laissez PAS le mot de passe dans ce fichier après l'installation.
SUPERADMIN_NAME="Super Administrateur"
SUPERADMIN_EMAIL=superadmin@anatt.bj
# SUPERADMIN_PASSWORD=

# Comptes nominatifs du circuit (ComptesCircuitSeeder) : un poste non renseigné
# n'est pas créé ; le mot de passe temporaire est affiché une seule fois.
# CONTROLEUR_NAME= CONTROLEUR_EMAIL= CONTROLEUR_FONCTION=
# DAF_NAME= DAF_EMAIL= DAF_FONCTION=
# DG_NAME= DG_EMAIL= DG_FONCTION=
