# ============================================================
#  ANaTT — .env de PRODUCTION (cPanel mutualisé, API sur sous-domaine)
#  Copier vers ".env" sur le serveur, puis renseigner les valeurs __...__
# ============================================================

APP_NAME="ANaTT Gestion Missions"
APP_ENV=production
# Générer en local : php artisan key:generate --show  (puis coller ici)
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-omsemo.anatt.bj

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Base de données (créée dans cPanel > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__cpaneluser_anatt__
DB_USERNAME=__cpaneluser_anatt__
DB_PASSWORD=__motdepasse_bdd__

# --- Sessions / cache / files : pas de Redis sur mutualisé ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- CORS : origine(s) du SPA autorisée(s) (séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=https://omsemo.anatt.bj

# --- Sauvegardes BDD (db:backup). Chemin mysqldump si hors PATH ---
DB_DUMP_BINARY=mysqldump

# --- E-mail (SMTP de l'hébergeur ou service externe) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.anatt.bj
MAIL_PORT=587
MAIL_USERNAME=noreply@anatt.bj
MAIL_PASSWORD=__motdepasse_smtp__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@anatt.bj"
MAIL_FROM_NAME="ANaTT Missions"

# --- Règles métier paiement ---
PAIEMENT_INDICATIF=229
PAIEMENT_ASYNC_SEUIL=50
MTN_COMPTE=SARALY

# --- SUPER_ADMIN initial (si vous importez via le seeder) ---
SUPERADMIN_NAME="Super Administrateur"
SUPERADMIN_EMAIL=admin@anatt.bj
SUPERADMIN_PASSWORD=__motdepasse_fort__
